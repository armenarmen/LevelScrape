    "express": "^5.2.1",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "linkedom": "^0.18.13",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
